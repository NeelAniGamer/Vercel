{
  "name": "class-of-learners",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "postbuild": "node scripts/production-check.js && node scripts/security-check.js --allow-missing-sources",
    "verify:production": "node scripts/production-check.js && node scripts/security-check.js",
    "security:check": "node scripts/security-check.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level=high",
    "security:fix": "npm audit fix",
    "test": "playwright test",
    "test:smoke": "playwright test --project=chromium"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "eslint": "^10.11.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "acorn": "^8.18.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  }
}
