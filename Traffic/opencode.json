{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-browser"
  ],
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "environment": {
        "SUPABASE_URL": "https://hvukxajztizsuhfubjws.supabase.co"
      },
      "enabled": true
    }
  }
}
