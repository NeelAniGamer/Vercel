{
  "name": "mumbai-traffic-hero",
  "version": "1.0.0",
  "description": "Mumbai Traffic Hero Academy - 3D Driving & Pedestrian Safety Simulator",
  "author": "Class Of Learners",
  "main": "electron/main.js",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build:web": "tsc --noEmit && vite build --mode web",
    "build:electron": "tsc --noEmit && vite build --mode electron && node build-electron.js && electron-builder",
    "electron:compile": "node build-electron.js",
    "electron:dev": "node run-dev.js",
    "electron:build": "vite build --mode electron && node build-electron.js && electron-builder",
    "electron:portable": "vite build --mode electron && node build-electron.js && electron-builder --portable",
    "electron:pack-test": "vite build --mode electron && node build-electron.js && electron-builder --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node pw_test.js"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^20.14.0",
    "@types/three": "^0.170.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "howler": "^2.2.4",
    "three": "0.170.0",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.classoflearners.traffic",
    "productName": "Mumbai Traffic Hero",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.js",
      "!electron/**/*.ts"
    ],
    "extraResources": [
      {
        "from": "Models",
        "to": "Models"
      },
      {
        "from": "textures",
        "to": "textures"
      },
      {
        "from": "levels",
        "to": "levels"
      },
      {
        "from": "skins",
        "to": "skins"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
