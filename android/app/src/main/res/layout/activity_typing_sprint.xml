<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/col_void"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btnBackTyping"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_outline"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="← Hub"
            android:textAllCaps="false"
            android:textColor="@color/col_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATI Speed &amp; Syntax Arena"
                android:textColor="@color/col_signal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="44.1 kHz Mechanical Switch Synthesizer"
                android:textColor="@color/col_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBestWpmBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_gold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Best: 0 WPM"
            android:textColor="@color/col_signal"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Curriculum Mode Strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipModeProse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_gold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="English Mastery"
                android:textColor="@color/col_signal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipModeCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_outline"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Python &amp; JS Code"
                android:textColor="@color/col_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipModeLaw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_outline"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Mumbai Traffic Law"
                android:textColor="@color/col_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipModeSpace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_outline"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Astrophysics"
                android:textColor="@color/col_ink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Switch Profile Selector -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipSwBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_cyan"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="🔊 Cherry MX Blue"
                android:textColor="@color/col_ion"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipSwTopre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_outline"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="🔊 Topre 45g Thock"
                android:textColor="@color/col_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipSwPanda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_outline"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="🔊 Holy Panda"
                android:textColor="@color/col_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipSwBuckling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_outline"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="🔊 Buckling Spring"
                android:textColor="@color/col_ink"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Live Metrics Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_glass"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLiveWpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/col_signal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WPM"
                android:textColor="@color/col_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLiveAcc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/col_emerald"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accuracy"
                android:textColor="@color/col_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLiveProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/col_ion"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completion"
                android:textColor="@color/col_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Target Passage Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_hero"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTargetPassage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="5dp"
            android:text="Target typing text..."
            android:textColor="@color/col_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Typing Input Box -->
    <EditText
        android:id="@+id/etTypingInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="Tap Here &amp; Start Typing Passage Above..."
        android:imeOptions="flagNoExtractUi"
        android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
        android:minLines="3"
        android:padding="14dp"
        android:textColor="@color/col_ink"
        android:textColorHint="@color/col_dim"
        android:textSize="15sp" />

    <!-- Bottom Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNewPassage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:text="New Passage"
            android:textAllCaps="false"
            android:textColor="@color/col_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFinishEarly"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_signal"
            android:text="Save Sprint Score"
            android:textAllCaps="false"
            android:textColor="@color/col_void"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
