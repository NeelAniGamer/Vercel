<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/col_void"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btnBackSolar"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_outline"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="← Hub"
            android:textAllCaps="false"
            android:textColor="@color/col_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solar System Engine"
                android:textColor="@color/col_ion"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60 FPS Keplerian Orbital Telemetry Sandbox"
                android:textColor="@color/col_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogSolarMission"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_cyan"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Log Scan (+35 XP)"
            android:textAllCaps="false"
            android:textColor="@color/col_void"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Planet Quick Selector Strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/planetChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 60fps Orbital Canvas -->
    <com.educational.col.ui.SolarOrbitView
        android:id="@+id/solarOrbitView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSolarPause"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:text="Pause"
            android:textAllCaps="false"
            android:textColor="@color/col_ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSolarOrbits"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:text="Orbits"
            android:textAllCaps="false"
            android:textColor="@color/col_ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSolarVectors"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:text="Vectors"
            android:textAllCaps="false"
            android:textColor="@color/col_ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnZoomOut"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_outline"
            android:text="−"
            android:textColor="@color/col_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnZoomIn"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_outline"
            android:text="+"
            android:textColor="@color/col_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Time Warp Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTimeWarpLabel"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="Time Warp: 1.0x"
            android:textColor="@color/col_signal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekTimeWarp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="15" />
    </LinearLayout>

    <!-- Selected Planet Telemetry Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_glass"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlanetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Earth"
                android:textColor="@color/col_ion"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlanetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Home Biosphere"
                android:textColor="@color/col_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4 Telemetry Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMetricDist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dist: 1.00 AU"
                android:textColor="@color/col_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMetricVel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vel: 29.8 km/s"
                android:textColor="@color/col_emerald"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMetricGrav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="g: 9.81 m/s²"
                android:textColor="@color/col_signal"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlanetSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Planet telemetry summary..."
            android:textColor="@color/col_dim"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
