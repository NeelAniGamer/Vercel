<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/col_void"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btnBackQr"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_outline"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="← Hub"
            android:textAllCaps="false"
            android:textColor="@color/col_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR Studio Matrix"
                android:textColor="@color/col_plasma"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISO-18004 Reed-Solomon Native Encoder"
                android:textColor="@color/col_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQrCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_plasma"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Created: 0"
            android:textColor="@color/col_plasma"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Preset Payload Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipQrUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_plasma"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="CoL Portal URL"
                        android:textColor="@color/col_plasma"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipQrWifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_btn_outline"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Wi-Fi Auto-Connect"
                        android:textColor="@color/col_ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipQrCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_btn_outline"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Learner Pass"
                        android:textColor="@color/col_ink"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Payload Input -->
            <EditText
                android:id="@+id/etQrPayload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="Enter URL, Text, Or Wi-Fi String..."
                android:inputType="textUri|textMultiLine"
                android:maxLines="3"
                android:padding="14dp"
                android:text="https://advancedlogiclabs.dpdns.org"
                android:textColor="@color/col_ink"
                android:textColorHint="@color/col_dim"
                android:textSize="14sp" />

            <!-- QR Preview Frame -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivQrPreview"
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:contentDescription="QR Matrix Preview"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <!-- Color Palette Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Color Theme"
                android:textColor="@color/col_dim"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipThemeGold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_gold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="● Signal Gold"
                        android:textColor="@color/col_signal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipThemeCyan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_cyan"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="● Ion Cyan"
                        android:textColor="@color/col_ion"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipThemeEmerald"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_emerald"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="● Emerald"
                        android:textColor="@color/col_emerald"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipThemeClassic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_outline"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="● Classic Contrast"
                        android:textColor="@color/col_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Module Style Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Module Geometry"
                android:textColor="@color/col_dim"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStyleSquare"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_outline"
                    android:text="Squares"
                    android:textAllCaps="false"
                    android:textColor="@color/col_ink"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnStyleDots"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_outline"
                    android:text="Rounded Dots"
                    android:textAllCaps="false"
                    android:textColor="@color/col_ink"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnStyleDiamond"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_outline"
                    android:text="Diamonds"
                    android:textAllCaps="false"
                    android:textColor="@color/col_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveQrXp"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_emerald"
                    android:text="Verify Matrix (+25 XP)"
                    android:textAllCaps="false"
                    android:textColor="@color/col_void"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnShareQr"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_signal"
                    android:text="Share QR PNG"
                    android:textAllCaps="false"
                    android:textColor="@color/col_void"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
